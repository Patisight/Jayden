<svg width="400" height="250" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- Chart background -->
  <rect x="50" y="30" width="320" height="180" fill="#2c3e50" stroke="#3498db" stroke-width="1"/>
  
  <!-- Grid lines -->
  <g stroke="#bdc3c7" stroke-width="0.5" opacity="0.3">
    <!-- Horizontal grid -->
    <line x1="50" y1="60" x2="370" y2="60"/>
    <line x1="50" y1="90" x2="370" y2="90"/>
    <line x1="50" y1="120" x2="370" y2="120"/>
    <line x1="50" y1="150" x2="370" y2="150"/>
    <line x1="50" y1="180" x2="370" y2="180"/>
    
    <!-- Vertical grid -->
    <line x1="100" y1="30" x2="100" y2="210"/>
    <line x1="150" y1="30" x2="150" y2="210"/>
    <line x1="200" y1="30" x2="200" y2="210"/>
    <line x1="250" y1="30" x2="250" y2="210"/>
    <line x1="300" y1="30" x2="300" y2="210"/>
    <line x1="350" y1="30" x2="350" y2="210"/>
  </g>
  
  <!-- Frequency response curve -->
  <path d="M 50 180 Q 100 160 150 140 Q 200 120 250 130 Q 300 140 350 150 L 370 155" 
        stroke="#3498db" stroke-width="3" fill="none"/>
  
  <!-- Peak markers -->
  <circle cx="150" cy="140" r="4" fill="#2ecc71"/>
  <circle cx="200" cy="120" r="4" fill="#2ecc71"/>
  <circle cx="250" cy="130" r="4" fill="#2ecc71"/>
  
  <!-- Axes -->
  <line x1="50" y1="210" x2="370" y2="210" stroke="#ecf0f1" stroke-width="2"/>
  <line x1="50" y1="30" x2="50" y2="210" stroke="#ecf0f1" stroke-width="2"/>
  
  <!-- Axis labels -->
  <text x="210" y="235" font-family="Arial" font-size="12" fill="#ecf0f1" text-anchor="middle">频率 (GHz)</text>
  <text x="25" y="120" font-family="Arial" font-size="12" fill="#ecf0f1" text-anchor="middle" transform="rotate(-90 25 120)">增益 (dBi)</text>
  
  <!-- Frequency markers -->
  <text x="100" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">1</text>
  <text x="150" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">2</text>
  <text x="200" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">3</text>
  <text x="250" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">4</text>
  <text x="300" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">5</text>
  <text x="350" y="225" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">6</text>
  
  <!-- Gain markers -->
  <text x="40" y="185" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">0</text>
  <text x="40" y="155" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">5</text>
  <text x="40" y="125" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">10</text>
  <text x="40" y="95" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">15</text>
  
  <!-- Title -->
  <text x="200" y="20" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">频率响应特性</text>
</svg>