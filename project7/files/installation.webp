<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="building" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#34495e;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- Building structure -->
  <rect x="50" y="150" width="300" height="120" fill="url(#building)" stroke="#3498db" stroke-width="1"/>
  
  <!-- Building details -->
  <rect x="70" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  <rect x="100" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  <rect x="130" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  <rect x="250" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  <rect x="280" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  <rect x="310" y="170" width="20" height="30" fill="#34495e" stroke="#bdc3c7" stroke-width="0.5"/>
  
  <!-- Rooftop antenna installation -->
  <rect x="180" y="130" width="40" height="20" rx="5" fill="#2c3e50" stroke="#3498db" stroke-width="2"/>
  
  <!-- Antenna mast -->
  <line x1="200" y1="130" x2="200" y2="80" stroke="#3498db" stroke-width="4"/>
  
  <!-- Antenna array on mast -->
  <rect x="190" y="70" width="20" height="15" rx="3" fill="#3498db"/>
  <circle cx="195" cy="77" r="2" fill="#ecf0f1"/>
  <circle cx="200" cy="77" r="2" fill="#ecf0f1"/>
  <circle cx="205" cy="77" r="2" fill="#ecf0f1"/>
  
  <!-- Signal coverage area -->
  <ellipse cx="200" cy="77" rx="120" ry="60" fill="none" stroke="#3498db" stroke-width="1" opacity="0.4" stroke-dasharray="5,5"/>
  <ellipse cx="200" cy="77" rx="80" ry="40" fill="none" stroke="#3498db" stroke-width="1" opacity="0.6" stroke-dasharray="3,3"/>
  <ellipse cx="200" cy="77" rx="40" ry="20" fill="none" stroke="#3498db" stroke-width="2" opacity="0.8"/>
  
  <!-- Control cable -->
  <path d="M 200 130 Q 220 140 240 160 Q 250 170 260 180" stroke="#f39c12" stroke-width="2" fill="none"/>
  
  <!-- Control room -->
  <rect x="240" y="180" width="40" height="30" fill="#2c3e50" stroke="#3498db" stroke-width="1"/>
  <rect x="245" y="185" width="30" height="20" fill="#34495e"/>
  <circle cx="250" cy="190" r="2" fill="#2ecc71"/>
  <circle cx="255" cy="190" r="2" fill="#3498db"/>
  <circle cx="260" cy="190" r="2" fill="#e74c3c"/>
  
  <!-- Ground level -->
  <line x1="0" y1="270" x2="400" y2="270" stroke="#bdc3c7" stroke-width="1"/>
  
  <!-- Labels -->
  <text x="200" y="30" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">屋顶安装示例</text>
  <text x="200" y="50" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">360°信号覆盖</text>
  <text x="260" y="230" font-family="Arial" font-size="8" fill="#bdc3c7" text-anchor="middle">控制室</text>
  <text x="200" y="290" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">智能物联网天线系统安装部署</text>
</svg>