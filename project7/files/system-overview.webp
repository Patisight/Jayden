<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#3498db;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2980b9;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- Main antenna system -->
  <rect x="150" y="80" width="100" height="140" rx="10" fill="url(#accent)" opacity="0.8"/>
  <rect x="160" y="90" width="80" height="120" rx="5" fill="#2c3e50"/>
  
  <!-- Antenna elements -->
  <circle cx="200" cy="120" r="8" fill="#3498db"/>
  <circle cx="200" cy="150" r="8" fill="#3498db"/>
  <circle cx="200" cy="180" r="8" fill="#3498db"/>
  
  <!-- Signal waves -->
  <path d="M 120 120 Q 140 100 160 120" stroke="#3498db" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 110 120 Q 135 90 160 120" stroke="#3498db" stroke-width="2" fill="none" opacity="0.4"/>
  <path d="M 240 120 Q 260 100 280 120" stroke="#3498db" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 240 120 Q 265 90 290 120" stroke="#3498db" stroke-width="2" fill="none" opacity="0.4"/>
  
  <!-- Control unit -->
  <rect x="50" y="200" width="80" height="50" rx="5" fill="#34495e" stroke="#3498db" stroke-width="1"/>
  <circle cx="70" cy="215" r="3" fill="#3498db"/>
  <circle cx="85" cy="215" r="3" fill="#e74c3c"/>
  <circle cx="100" cy="215" r="3" fill="#f39c12"/>
  
  <!-- Connection lines -->
  <line x1="130" y1="225" x2="150" y2="200" stroke="#3498db" stroke-width="2"/>
  
  <!-- Labels -->
  <text x="200" y="260" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">智能物联网天线系统</text>
  <text x="90" y="280" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">控制单元</text>
  <text x="200" y="50" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">多频段天线阵列</text>
</svg>