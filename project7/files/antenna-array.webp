<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="antenna" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#3498db;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2980b9;stop-opacity:1" />
    </radialGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- PCB Board -->
  <rect x="50" y="50" width="300" height="200" rx="10" fill="#2c3e50" stroke="#3498db" stroke-width="2"/>
  
  <!-- Antenna elements in array -->
  <g id="antenna-element">
    <!-- Top row -->
    <circle cx="120" cy="100" r="12" fill="url(#antenna)"/>
    <circle cx="200" cy="100" r="12" fill="url(#antenna)"/>
    <circle cx="280" cy="100" r="12" fill="url(#antenna)"/>
    
    <!-- Middle row -->
    <circle cx="120" cy="150" r="12" fill="url(#antenna)"/>
    <circle cx="200" cy="150" r="12" fill="url(#antenna)"/>
    <circle cx="280" cy="150" r="12" fill="url(#antenna)"/>
    
    <!-- Bottom row -->
    <circle cx="120" cy="200" r="12" fill="url(#antenna)"/>
    <circle cx="200" cy="200" r="12" fill="url(#antenna)"/>
    <circle cx="280" cy="200" r="12" fill="url(#antenna)"/>
  </g>
  
  <!-- Connection traces -->
  <line x1="120" y1="100" x2="200" y2="100" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="200" y1="100" x2="280" y2="100" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="120" y1="150" x2="200" y2="150" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="200" y1="150" x2="280" y2="150" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="120" y1="200" x2="200" y2="200" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="200" y1="200" x2="280" y2="200" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  
  <!-- Vertical connections -->
  <line x1="120" y1="100" x2="120" y2="200" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="200" y1="100" x2="200" y2="200" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  <line x1="280" y1="100" x2="280" y2="200" stroke="#3498db" stroke-width="1" opacity="0.6"/>
  
  <!-- Feed points -->
  <rect x="195" y="220" width="10" height="15" fill="#e74c3c"/>
  <text x="200" y="245" font-family="Arial" font-size="8" fill="#ecf0f1" text-anchor="middle">RF IN</text>
  
  <!-- Labels -->
  <text x="200" y="30" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">3×3 天线阵列</text>
  <text x="200" y="280" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">多频段MIMO天线单元</text>
</svg>