<svg width="400" height="250" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="pattern" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#3498db;stop-opacity:0.8" />
      <stop offset="50%" style="stop-color:#2980b9;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#34495e;stop-opacity:0.2" />
    </radialGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- Polar grid -->
  <g stroke="#bdc3c7" stroke-width="0.5" opacity="0.3" fill="none">
    <!-- Concentric circles -->
    <circle cx="200" cy="125" r="20"/>
    <circle cx="200" cy="125" r="40"/>
    <circle cx="200" cy="125" r="60"/>
    <circle cx="200" cy="125" r="80"/>
    <circle cx="200" cy="125" r="100"/>
    
    <!-- Radial lines -->
    <line x1="200" y1="25" x2="200" y2="225"/>
    <line x1="100" y1="125" x2="300" y2="125"/>
    <line x1="129" y1="54" x2="271" y2="196"/>
    <line x1="271" y1="54" x2="129" y2="196"/>
  </g>
  
  <!-- Main radiation pattern -->
  <path d="M 200 125 
           L 200 45
           Q 220 50 235 70
           Q 245 90 240 110
           Q 235 130 220 145
           Q 200 155 180 145
           Q 165 130 160 110
           Q 155 90 165 70
           Q 180 50 200 45 Z" 
        fill="url(#pattern)" stroke="#3498db" stroke-width="2"/>
  
  <!-- Secondary lobes -->
  <ellipse cx="200" cy="60" rx="15" ry="8" fill="#3498db" opacity="0.4"/>
  <ellipse cx="200" cy="190" rx="12" ry="6" fill="#3498db" opacity="0.3"/>
  <ellipse cx="140" cy="125" rx="8" ry="12" fill="#3498db" opacity="0.3"/>
  <ellipse cx="260" cy="125" rx="8" ry="12" fill="#3498db" opacity="0.3"/>
  
  <!-- Center point (antenna) -->
  <circle cx="200" cy="125" r="3" fill="#e74c3c"/>
  
  <!-- Angle markers -->
  <text x="200" y="15" font-family="Arial" font-size="10" fill="#ecf0f1" text-anchor="middle">0°</text>
  <text x="310" y="130" font-family="Arial" font-size="10" fill="#ecf0f1" text-anchor="middle">90°</text>
  <text x="200" y="245" font-family="Arial" font-size="10" fill="#ecf0f1" text-anchor="middle">180°</text>
  <text x="85" y="130" font-family="Arial" font-size="10" fill="#ecf0f1" text-anchor="middle">270°</text>
  
  <!-- Gain level markers -->
  <text x="220" y="105" font-family="Arial" font-size="8" fill="#bdc3c7">-10dB</text>
  <text x="240" y="85" font-family="Arial" font-size="8" fill="#bdc3c7">-20dB</text>
  <text x="260" y="65" font-family="Arial" font-size="8" fill="#bdc3c7">-30dB</text>
  
  <!-- Title -->
  <text x="200" y="20" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">辐射方向图</text>
</svg>