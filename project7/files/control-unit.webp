<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="screen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#34495e;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)"/>
  
  <!-- Main control unit housing -->
  <rect x="100" y="80" width="200" height="140" rx="15" fill="#2c3e50" stroke="#3498db" stroke-width="2"/>
  
  <!-- Display screen -->
  <rect x="120" y="100" width="160" height="80" rx="5" fill="url(#screen)" stroke="#3498db" stroke-width="1"/>
  
  <!-- Screen content -->
  <rect x="130" y="110" width="140" height="8" fill="#3498db" opacity="0.8"/>
  <rect x="130" y="125" width="100" height="6" fill="#2ecc71" opacity="0.6"/>
  <rect x="130" y="135" width="120" height="6" fill="#f39c12" opacity="0.6"/>
  <rect x="130" y="145" width="80" height="6" fill="#e74c3c" opacity="0.6"/>
  <rect x="130" y="155" width="110" height="6" fill="#9b59b6" opacity="0.6"/>
  
  <!-- Status indicators -->
  <circle cx="250" cy="120" r="4" fill="#2ecc71"/>
  <circle cx="250" cy="135" r="4" fill="#3498db"/>
  <circle cx="250" cy="150" r="4" fill="#f39c12"/>
  
  <!-- Control buttons -->
  <circle cx="130" cy="200" r="8" fill="#34495e" stroke="#3498db" stroke-width="1"/>
  <circle cx="155" cy="200" r="8" fill="#34495e" stroke="#3498db" stroke-width="1"/>
  <circle cx="180" cy="200" r="8" fill="#34495e" stroke="#3498db" stroke-width="1"/>
  <circle cx="205" cy="200" r="8" fill="#34495e" stroke="#3498db" stroke-width="1"/>
  
  <!-- Connection ports -->
  <rect x="90" y="130" width="8" height="15" fill="#2c3e50" stroke="#3498db" stroke-width="1"/>
  <rect x="90" y="150" width="8" height="15" fill="#2c3e50" stroke="#3498db" stroke-width="1"/>
  <rect x="302" y="130" width="8" height="15" fill="#2c3e50" stroke="#3498db" stroke-width="1"/>
  <rect x="302" y="150" width="8" height="15" fill="#2c3e50" stroke-width="1"/>
  
  <!-- Antenna connection -->
  <line x1="200" y1="80" x2="200" y2="50" stroke="#3498db" stroke-width="3"/>
  <circle cx="200" cy="45" r="5" fill="#3498db"/>
  
  <!-- Labels -->
  <text x="200" y="30" font-family="Arial" font-size="14" fill="#ecf0f1" text-anchor="middle">智能控制单元</text>
  <text x="80" y="140" font-family="Arial" font-size="8" fill="#bdc3c7" text-anchor="middle">IN</text>
  <text x="320" y="140" font-family="Arial" font-size="8" fill="#bdc3c7" text-anchor="middle">OUT</text>
  <text x="200" y="280" font-family="Arial" font-size="10" fill="#bdc3c7" text-anchor="middle">实时监控与智能调节</text>
</svg>